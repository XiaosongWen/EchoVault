APP_ENV=development
LOG_LEVEL=INFO
# Direct database connection (backend only):
# Supports postgresql:// or postgresql+asyncpg://
DATABASE_URL=postgresql://user:pass@localhost:5432/echovault
# Dedicated Postgres schema for multi-app database sharing (isolates tables from other apps)
DB_SCHEMA=echovault

SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Privileged key: backend only, never exposed to clients (see TASK-02 security boundaries)
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
